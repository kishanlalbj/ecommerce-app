# development = pretty logs, production = JSON logs
NODE_ENV=development
# Optional: fatal | error | warn | info | debug | trace | silent (default: debug in dev, info in prod)
# LOG_LEVEL=debug
PORT=3000
DATABASE_URL=postgres://admin:adminpass@localhost:5433/fashionshop
# Optional cache (docker-compose's redis). If it's down the API still works, uncached.
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Stripe test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_
# For local dev run: stripe listen --forward-to localhost:3000/payments/webhook
# and paste the whsec_... it prints
STRIPE_WEBHOOK_SECRET=whsec_
# Where Stripe redirects customers after checkout (the Vite client)
CLIENT_URL=http://localhost:5173
CURRENCY=usd
